# Sanity project information
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_VERSION=2026-09-01

# Only needed for contact form writes from the server.
# Create a token with Editor/Write access and NEVER expose it as NEXT_PUBLIC_.
SANITY_WRITE_TOKEN=your_write_token

# Optional: set when using Sanity's Visual Editing / Presentation Tool.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
